# Copie para jenkins/.env (ignorado pelo git)
JENKINS_ADMIN_PASSWORD=troque-esta-senha

# Token fine-grained só deste repo: Contents (read), Metadata (read), Commit statuses (read/write)
GITHUB_USER=Frombull
GITHUB_TOKEN=github_pat_xxx

# Quem recebe o e-mail de cada build (vários separados por vírgula). Sem isto, o pipeline não manda e-mail.
# Por padrão o e-mail vai para o Mailpit do compose: veja em http://localhost:8025
NOTIFY_EMAIL=voce@exemplo.com

# Para mandar e-mail de verdade, aponte para um SMTP real (ex.: Gmail com uma senha de app):
# SMTP_URL=smtps://smtp.gmail.com:465
# SMTP_USER=voce@gmail.com
# SMTP_PASSWORD=senha-de-app
# MAIL_FROM=voce@gmail.com
