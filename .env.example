# Copie para .env (ignorado pelo git)

# Faz o "docker compose up -d" subir também o Jenkins (precisa de jenkins/.env). Sem isso sobe só o app.
COMPOSE_PROFILES=jenkins

# Só no Linux: stat -c %g /var/run/docker.sock
# DOCKER_GID=999

# Valores de desenvolvimento; ajuste para uso real (todos têm padrão no docker-compose.yml)
# Senha para criar salas (painel do apresentador)
# PRESENTER_PASSWORD=miau
# Senha do Postgres do compose
# POSTGRES_PASSWORD=cathoot
# Portas publicadas no host (0 = aleatória)
# WEB_PORT=3000
# API_PORT=3001
# POSTGRES_PORT=5432

# Só para rodar a API fora do Docker (pnpm --filter api dev). O Postgres do compose escuta em localhost:5432
# DATABASE_URL=postgresql://cathoot:cathoot@localhost:5432/cathoot
