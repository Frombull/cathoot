# Copie para .env (ignorado pelo git) e ajuste para produção no servidor

# Senha para criar salas (painel do apresentador)
# PRESENTER_PASSWORD=miau

# Senha do Postgres do compose
# POSTGRES_PASSWORD=cathoot

# Em produção com reverse proxy (Caddy/Nginx) na mesma máquina, prenda a API em localhost:
# API_BIND=127.0.0.1
# API_PORT=3001

# Interface e porta do Postgres no host (por padrão só escuta em localhost)
# POSTGRES_BIND=127.0.0.1
# POSTGRES_PORT=5432

# Porta do frontend no compose local
# WEB_PORT=3000

# Alunos simulados no teste de carga (docker compose --profile load run --rm load)
# STUDENTS=60

# Só para rodar a API fora do Docker (pnpm --filter api dev). O Postgres do compose escuta em localhost:5432
# DATABASE_URL=postgresql://cathoot:cathoot@localhost:5432/cathoot
